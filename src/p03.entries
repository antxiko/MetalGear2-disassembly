# Puntos de entrada del banco 3 (se ejecuta en 0xa000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador (cartucho.DESPACHADOR), que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0xA000   # p02:9FFF sigue de largo (el codigo cruza la frontera de banco)
0xA021   # p64:C201 call (se ejecuta copiado en 0xC2A0)
0xA06B   # p64:C2E5 jr cc (se ejecuta copiado en 0xC2EA)
0xA077   # p64:C2F3 jr cc (se ejecuta copiado en 0xC2F6)
0xA07F   # p64:C2BE jr cc (se ejecuta copiado en 0xC2FE)
0xA089   # p64:C316 jr cc (se ejecuta copiado en 0xC308)
0xA0B4   # p64:C306 jr cc (se ejecuta copiado en 0xC333)
0xA0B6   # la interrupcion: p00:40D1 pone jp 0xC200 en H.KEYI; es la copia de p03:A0B6 (cartucho.COPIAS_RAM) (se ejecuta copiado en 0xC200)
0xA0C1   # p64:C204 jr cc (se ejecuta copiado en 0xC20B)
0xA0CF   # p64:C216 jr cc (se ejecuta copiado en 0xC219)
0xA0DA   # p64:C21E jr cc (se ejecuta copiado en 0xC224)
0xA0E2   # p64:C229 jr cc (se ejecuta copiado en 0xC22C)
0xA0E5   # p64:C20F jr cc (se ejecuta copiado en 0xC22F)
0xA142   # p64:C284 jr cc (se ejecuta copiado en 0xC28C)
0xA146   # p64:C234 jr cc (se ejecuta copiado en 0xC290)
0xA14B   # p01:6B32 jp (se ejecuta copiado en 0xC340)
0xA186   # p06:B066 call (se ejecuta copiado en 0xC000)
0xA1BB   # p01:759B call
0xA1DE   # p01:7FB6 call
