C 0xBC82 la paleta de la sala y la pagina en negro
C 0xBC88 el barrido desde (0x60, 0x60)
C 0xBC91 los sprites 28-31 fuera
C 0xA3DA a menos de 0x10 en Y...
C 0xA3DD ...y la X...
C 0xA3E1 ...a menos de 0x0C
C 0xA3EA IX...
C 0xA3ED .../ 16
C 0xA4A9 el eje...
C 0xA4B2 en vertical: hacia arriba (0) o abajo (1)
C 0xA6B6 la Y del par
C 0xA6B8 X = 0x58
C 0xA6BE segun la espera, los patrones 0x28/0x2C o 0x30/0x34
C 0xA767 la Y y la X de Snake
C 0xA76B la X en 0x38-0xC7...
C 0xA771 ...y la Y en 0x50-0x7F
C 0xA88A en vertical: 0 o 2 al azar
C 0xA8B0 la direccion del dibujo...
C 0xA8B6 ...el bit de C
C 0xA9BC B = la Y
C 0xA9BD en 0x40-0x97...
C 0xA9C5 ...la X: por debajo de 0x30, 0x18...
C 0xA9CB ...de 0x48, 0x48...
C 0xA9D1 ...desde 0x98, 0xA8...
C 0xA9D7 ...desde 0x78 con la Y en 0x70-0x7F, 0xA8
