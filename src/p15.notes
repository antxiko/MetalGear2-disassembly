# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0xA000 puertas_sin_cuentas carga las puertas de la sala (p15:A04C) y las pinta (p15:A008), sin bajar las cuentas de 0xD580
L 0xA005 puertas_de_la_sala baja las cuentas de 0xD580 (p15:A1E2), carga las puertas de la sala y las pinta
L 0xA008 pinta_puertas con la pantalla partida, nada; cada ficha activa de 0xD500: en el estado 2 o con su cuenta de 0xD580, abierta (p15:A1F3, estado 2); si no, estado 0 y cerrada (p15:A12B)
L 0xA013 puerta_al_pintar 
L 0xA02E puerta_ya_abierta pintada abierta y en el estado 2
L 0xA035 puerta_cerrada_al_entrar el estado 0 y pintada cerrada
L 0xA03D pon_estado_puerta 
L 0xA040 puerta_siguiente la ficha siguiente (16 bytes)
L 0xA049 cuentas_y_puertas baja las cuentas de 0xD580 y carga las puertas (p15:A04C)
L 0xA04C carga_puertas 0xD500 a cero y las puertas de la sala de la lista de la zona (p15:AD0C) o de la sala especial (p15:B1FE): 6 bytes [sala][tipo][Y][X][pide][numero], 0xFF al final; cada una con su alto y ancho (p15:A1A8) y los casos de algunas zonas
L 0xA064 lista_de_puertas HL = la lista; desde la primera ficha
L 0xA06B puerta_de_la_lista 
L 0xA0A1 puerta_sala_18 en la sala especial 0x18, la de numero 0x1C con el bit 0 de 0xD7DA: no pide nada
L 0xA0B7 puerta_tipo_0c las de tipo 0x0C con el bit 0 de 0xD7DA o con 0xD441 no piden nada
L 0xA0CB puerta_no_pide lo que pide (byte 4) a 0
L 0xA0CF puerta_sala_29 en la sala especial 0x29, sala 2, con 0xD4F2: la ficha libre
L 0xA0E5 puerta_por_zona las zonas 0x0E, 0x13 y 0x12
L 0xA0F6 puerta_zona_0e con 0xD885 = 0xFF, no pide nada
L 0xA0FE puerta_zona_13 con 0xD884 = 0xFF, las de numero 0 y 1 no piden nada
L 0xA10D puerta_zona_12 con 0xD889 = 0xFF, la de numero 0x13 no pide nada
L 0xA11A puerta_sin_pedir lo que pide (byte 4) a 0
L 0xA11E ficha_d500_siguiente la ficha siguiente (16 bytes)
L 0xA123 puerta_lista_siguiente la siguiente de la lista (6 bytes)
L 0xA12B pinta_puerta_cerrada salvo p15:A17B, las de tipo 3 y 4: 7 piezas de 8 x 8 en columna (X de p15:A16D o p15:A174, Y = 0x78) desde su sitio con la X de 8 en 8, en la otra pagina con la operacion 0xC8
L 0xA140 piezas_de_puerta DE = (X de 8 en 8, Y) y 7 piezas
L 0xA14B pieza_de_puerta 
L 0xA17B puerta_no_se_pinta acarreo (no se pinta): en la zona 3 sala 0 con 0xCAC9, en la zona 4 sala 0x0E con 0xCACD; con lo elegido 3, nunca
L 0xA19C zona_3_sala_0 en la zona 3, la sala 0 con 0xCAC9: acarreo
L 0xA1A6 puerta_se_pinta sin acarreo: se pinta
L 0xA1A8 alto_y_ancho el alto (byte 7) y el ancho (byte 8) de su tipo, de la tabla de p15:A1B8
L 0xA1E2 baja_cuentas_d580 las 0x80 cuentas de 0xD580 uno menos (las de 0 y las de 0xFF no)
L 0xA1E7 cuenta_d580 
L 0xA1EF cuenta_d580_siguiente 
L 0xA1F3 pinta_puerta_abierta por su tipo (tabla p15:A1FA)
L 0xA224 pinta_abierta_0d las 4 filas de 3 piezas (p01:7D66) en su sitio, con la pagina de dibujar cambiada a la otra mientras
L 0xA238 pinta_abierta su rectangulo (alto x ancho) a 0xFF en la otra pagina (p15:A255) y sus casillas del mapa libres (p15:A241)
L 0xA241 casillas_de_puerta las casillas del mapa de la puerta (p15:A890): ancho / 8 desde la Y + el alto - 0x10
L 0xA255 puerta_a_ff BC desde su sitio a 0xFF en la otra pagina
L 0xA258 rellena_otra_ff BC desde HL a 0xFF en la otra pagina (p00:46FF)
L 0xA263 sitio_de_puerta HL = su sitio: L = la Y (byte 2), H = la X (byte 3)
L 0xA26A pinta_abierta_3 las 8 rayas hacia la derecha (p15:A276, E = 1) y sus casillas del mapa desde su X (p15:A6EB)
L 0xA276 rayas_de_a2a5 8 rayas verticales de color 0x0F en la otra pagina desde su sitio, con los largos de p15:A2A5 (del ultimo al primero), cada una E mas a la X y, desde la tercera, 4 mas abajo
L 0xA27D raya_de_a2a5 
L 0xA2A1 raya_siguiente_a2a5 la raya siguiente, hasta 8
L 0xA2A4 tipo_sin_nada nada (los tipos 0x0E y 0x14)
L 0xA2AD pinta_abierta_4 las 8 rayas hacia la izquierda (E = -1) y sus casillas desde la X - 1
L 0xA2BA pinta_abierta_7 4 rayas horizontales de color 0x0F desde (X + 3, Y), de 0x11 y 2 mas cada una, una mas abajo y una a la izquierda; luego (alto - 3) x ancho desde (X, Y + 3) a 0xFF y sus casillas
L 0xA2CB raya_tipo_7 
L 0xA2EB abre_las_fijas 0xD580 a cero y las que estan siempre abiertas (0xFF): zona 2 las 4 y 1, zona 3 las 4 y 0x25, zona 5 las 0x0E y 0x1B
L 0xA311 abre_dos las cuentas de HL y DE a 0xFF
L 0xA316 puertas_cada_cuadro sin 0xD4E9 ni salida de la sala: cada puerta activa por su tipo (p15:A368); la primera que queda abriendose o cerrandose (estado 1 o 4) va a 0xCAE8 con 0xCAE7 = 1 y se deja
L 0xA327 puerta_cada_cuadro la ficha por su tipo; si queda en el estado 1 o 4, se deja
L 0xA340 puerta_siguiente_cuadro la ficha siguiente (16 bytes), hasta 8
L 0xA348 puerta_en_marcha 0xCAE7 = 1 y la ficha en 0xCAE8
L 0xA354 sigue_puerta_en_marcha la puerta de 0xCAE8 por su tipo (p15:A368); fuera del estado 1 o 4, 0xCAE7 = 0
L 0xA368 puerta_por_tipo salta por su tipo (tabla p15:A36F)
L 0xA399 lo_que_pide acarreo si se abre: sin 0xCB4B y sin nada que pedir (byte 4 = 0) o con lo elegido (0xCB21) que sirve: 0x11, 0x12 y 0x13 abren las 1-3, 4-6 y 7-9; 0x14-0x1C, una de la 1 a la 9
L 0xA3A7 mira_lo_elegido con lo elegido 0x11-0x1C
L 0xA3BA no_sirve sin acarreo: no se abre
L 0xA3BC sirve_de_tres (n + 1) * 3 - lo que pide...
L 0xA3C4 tipo_0d por su estado (tabla p15:A3CA)
L 0xA3D2 tipo_0d_cerrada si Snake entra (p15:A44B): la de numero 0x1A en la zona 4 (4 en las demas) pide lo elegido 0x10 con 0xCA89 = 4 (0 fuera de la zona 4, y entonces fuera el bit 0 de 0xD7DD); se abre: su cuenta (p15:ACDE) y el estado siguiente (p15:A887)
