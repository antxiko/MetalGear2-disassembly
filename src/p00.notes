L 0x43F6 palabra_de_tabla HL = la palabra A de la tabla de HL
L 0x43FC lee_palabra HL = la palabra que hay en HL
L 0x4403 palabra_de_tabla_de DE = la palabra A de la tabla de DE
L 0x443A hl_negativo HL = -HL (PR2 p00:5BBD)
L 0x4468 lee_de_vram_espera espera al VDP y copia BC bytes de la VRAM de HL a DE
L 0x446B lee_de_vram copia BC bytes de la VRAM de HL a DE (PR2 p00:463B)
L 0x447E cuenta_para_otir pasa BC a B (bytes) y A (vueltas de 256) para otir/inir
L 0x4486 copia_a_vram_espera espera al VDP (p00:4650) y copia BC bytes de HL a la VRAM de DE
L 0x4489 copia_a_vram copia BC bytes de HL a la VRAM de DE (PR2 p00:45ED)
L 0x449C llena_vram llena con A BC bytes de la VRAM de HL (pagina en D)
L 0x44E2 vram_para_escribir pone en el VDP la direccion de escritura HL (A bit 0 = la mitad alta, R#14)
L 0x4503 vram_para_leer pone en el VDP la direccion de lectura HL (A bit 0 = la mitad alta, R#14)
L 0x4522 registro_vdp escribe B en el registro C del VDP
L 0x4534 rachas_otro_destino la orden 0x80 de las rachas: [pagina][VRAM lo hi] y sigue
L 0x453E rachas_a_vram deshace las rachas de DE en la VRAM de HL (n < 0x80 repite, n > 0x80 copia n & 0x7F, 0x80 cambia de destino, 0 acaba); C bit 0 = voltear
L 0x456E rachas_a_vram_tal_cual p00:453E sin voltear (C = 0)
L 0x45A3 byte_volteado_si lee el byte de DE y lo voltea si C lleva el bit 0
L 0x45A8 bits_al_reves da la vuelta a los 8 bits de A (PR2 p00:4827)
L 0x45BE scroll_a_cero R#23 = 0 (el desplazamiento vertical)
L 0x45C5 enciende_pantalla R#1 con el bit 6 (BL) a uno, desde la copia 0xF3E0
L 0x45CC apaga_pantalla R#1 con el bit 6 (BL) a cero, desde la copia 0xF3E0
L 0x45D7 esconde_sprites_vram llena con 0xE0 128 bytes de la VRAM en 0xF600 y otros 128 en 0xF200
L 0x45F1 apaga_pantalla_y_sprites p00:45CC y p00:45F6
L 0x45F6 apaga_sprites R#8 con el bit 1 (SPD) a uno, desde la copia 0xFFE7
L 0x4609 enciende_sprites R#8 con el bit 1 (SPD) a cero, desde la copia 0xFFE7
L 0x4642 pon_paleta pone la paleta de HL (PR2 p00:4AD8)
L 0x4650 espera_vdp espera a que el VDP acabe la orden en curso (S#2 bit 0)
L 0x465C lee_estado_vdp A = el registro de estado A del VDP (por R#15, que vuelve a 0)
L 0x467C linea_horizontal orden LINE del VDP (R#36-R#46) con el lado largo en X
L 0x4680 linea_vertical orden LINE del VDP con el lado largo en Y (ARG = 1)
L 0x46BC marco cuatro lineas: un marco de D x E desde HL
L 0x46DA linea_vertical_guarda p00:4680 guardando AF, HL, DE y BC
L 0x46E6 linea_horizontal_guarda p00:467C guardando AF, HL, DE y BC
L 0x46F2 borra_bloque_pagina p00:46FF en la pagina en la que se dibuja (0xCA42)
L 0x46FA borra_bloque_pagina_0 p00:46FF con A = 0 en la pagina en la que se dibuja
L 0x46FF borra_bloque_vram llena un rectangulo de la VRAM con un color (PR2 p00:4B9D)
L 0x473B copia_rectangulo_a_3 p00:4767 de la pagina 0xCA42 a la 3
L 0x4744 copia_rectangulo_a_2 p00:4767 de la pagina 0xCA42 a la 2
L 0x474D copia_rectangulo_a_esta p00:4767 de la otra pagina (0xCA42 ^ 1) a la de 0xCA42
L 0x475A copia_rectangulo_a_la_otra p00:4767 de la pagina 0xCA42 a la otra
L 0x4767 copia_rectangulo orden HMMM del VDP: copia un rectangulo de BC de (H,L) a (D,E); A = paginas (bits 0-1 origen, 2-3 destino)
L 0x47AB copia_en_y orden YMMM del VDP
L 0x47ED copia_rectangulo_logica orden LMMM del VDP con la operacion logica de A
L 0x4840 punto orden PSET del VDP con la operacion logica de E
