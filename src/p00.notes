L 0x4403 palabra_de_tabla_de DE = la palabra A de la tabla de DE
L 0x4411 punto_a_mapa H = X, L = Y en puntos; A = X / 8, la columna
L 0x443A hl_negativo HL = -HL (PR2 p00:5BBD)
L 0x4442 de_negativo DE = -DE
L 0x444A borra_pagina_0_negro la pagina D entera a 0 desde (0, 0)
