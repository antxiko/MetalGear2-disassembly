L 0x423E suma_a_hl HL = HL + A
L 0x4243 suma_a_de DE = DE + A
L 0x4248 byte_de_tabla A = el byte A de la tabla de HL (y HL apunta a el)
L 0x424D despachador salta a la palabra A de la tabla que va detras del call
L 0x424E salta_por_tabla salta a la palabra A de la tabla de HL
L 0x4256 azar A = un numero al azar (0xCA03 rotado mas R)
