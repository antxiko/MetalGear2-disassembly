L 0xBD2F cajas_de_la_sala B = cuantas y HL' = sus sitios: la sala 0x17 2 (p07:BD62), la 0x13 2 (p07:BD6C), la 0x12 4 (p07:BD66), la 0x0D 4 (p07:BD5E), la 0x0E 4 (p07:BD70); Z si es una de ellas
L 0xBD78 caja_cc00 la caja de la ficha de 0xCC00 activa y en esta sala: en (Y + 0x0C, X + 4), 8 x 0x10 (acarreo)
L 0xBD9F sin_caja_nc sin caja: sin acarreo
L 0xBDA1 caja_cc80_b la caja de la ficha de 0xCC80 activa y en esta sala: en (Y + 0x0C, X + 4), 8 x 0x10
L 0xBDC8 caja_d760_b la caja de la ficha 0xD760 activa y en esta sala: en (Y + 0x22, X + 9), 0x0A x 0x23
