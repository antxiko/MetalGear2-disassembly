C 0xBCE9 suma_a_hl: HL = HL + A
C 0xBCF0 palabra_hl: HL = la palabra de HL
C 0xBD08 lee la zona
C 0xBD0F cajas_de_la_sala: B = cuantas y HL' = sus sitios: la sala 0x17 2 (p07:BD62), la 0x13 2 (p07:BD6C), la 0x12 4 (p07:BD66), la 0x0D 4 (p07:BD5E), la 0x0E 4 (p07:BD70); Z si es una de ellas
C 0xBD1B palabra_hl: HL = la palabra de HL
C 0xBD27 cajas_de_la_sala: B = cuantas y HL' = sus sitios: la sala 0x17 2 (p07:BD62), la 0x13 2 (p07:BD6C), la 0x12 4 (p07:BD66), la 0x0D 4 (p07:BD5E), la 0x0E 4 (p07:BD70); Z si es una de ellas
C 0xBD36 lee la sala de la zona
C 0xBD7E lee la fila de la sala en la zona (uno mas al salir por arriba)
C 0xBD86 lee la columna de la sala en la zona (uno mas al salir por la derecha)
C 0xBDA7 lee la fila de la sala en la zona (uno mas al salir por arriba)
C 0xBDAF lee la columna de la sala en la zona (uno mas al salir por la derecha)
C 0xBDCE lee la fila de la sala en la zona (uno mas al salir por arriba)
C 0xBDD6 lee la columna de la sala en la zona (uno mas al salir por la derecha)
C 0xBDF5 lee la fila de la sala en la zona (uno mas al salir por arriba)
C 0xBDFD lee la columna de la sala en la zona (uno mas al salir por la derecha)
