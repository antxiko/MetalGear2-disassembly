L 0xBE16 caja_cosa la caja de la cosa de 0xD7C0 (si hay): en (Y + 0x10, X + 8), 0x0A x 0x12
L 0xBE2D caja_e070 la caja de la ficha de 0xE070: en (Y + 0x20, X + 0x10), 0x10 x 0x20
L 0xBE3E sin_acarreo_be3e 
L 0xBE40 choques_d800_tipo_2 con la ficha 0xD800 de tipo 2 en la sala 8, con 0xD816 y por debajo del paso 0x0A: Snake dentro de su forma va al estado 0x14 (p07:BE8E), la ficha 0 de 0xDF80 le quita vida (p07:BED8) y lo lanzado por Snake de tipos 1-2 y 6 que entra en ella se acaba
L 0xBE63 lanzado_en_d800_2 
L 0xBE79 siguiente_lanzado_d800_2 
L 0xBE82 tipo_que_entra los tipos 1, 2 y 6 se miran (p07:BE9F); los demas, no
L 0xBE8E snake_en_d800_2 Snake (X - 4, Y) dentro de la forma: al estado 0x14
L 0xBE9F dentro_de_la_forma acarreo si (B = X, C = Y) cae dentro de la forma de la ficha: por la fila (0x0F - (Y de la ficha - C) / 8), una franja de X de p07:BF2C (filas 0-0x0B) o dos de p07:BF4C (las demas)
L 0xBEBA en_la_franja acarreo con B - desde < ancho
L 0xBEBE dos_franjas las demas: dos franjas de p07:BF4C (4 bytes)
L 0xBEC5 una_de_dos 
L 0xBED8 df80_en_d800_2 con 0xD816 y la ficha 0 de 0xDF80 activa con su byte 7 a cero: si su sitio (+8, +8) cae en la forma (filas 0x0A en adelante, p07:BF44), el sonido 0x48 y uno menos a 0xD810; a 0, el paso 0x0A y fuera lo lanzado; si no, 0xD816 = 0 y 0xD817 = 0x10
L 0xBF22 d816_a_cero 0xD816 = 0...
L 0xBF5C toca_e230_o_fijas acarreo si la caja de (H, L, D, E) toca la ficha 0xE230, la caja de la zona 0x0C sala 6 o alguna de las de p12:7F25
L 0xBF64 toca_e230_b 
L 0xBF7D cajas_7f25 0xCB74 = 0 y las cajas de p12:7F25 una tras otra hasta 0xCB74 = 0xFF; acarreo con la que toca
L 0xBF82 caja_7f25 
L 0xBF8C sin_acarreo_bf8c 
L 0xBF8E toca_7f25 
L 0xBF94 caja_e230 con 0xE230, su caja en (Y = 0xE233 + 0x32, X = 0xE234), 0x32 x 0x34
L 0xBFAA caja_0c_6 en la zona 0x0C sala 6, la caja de (Y = 0xB8, X = 0x40), 0x30 x 0xB0
L 0xBFBF toca_bfbf 
