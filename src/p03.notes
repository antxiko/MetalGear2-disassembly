L 0xBCBA rectangulo_de_cosa HL = (X + 8, Y + 0x10) de la cosa, DE = 0x10 x 8; con la X impar y 0xCB31, nada
L 0xBCDF coge_cosa el tipo
L 0xBCFA sonido_de_coger 
L 0xBCFD apunta_cogida el byte 3: con el bit 6, la bandera de 0xD7F0; sin el, la de la sala (0xD8D8); 0x3F y 0x09, ninguna
L 0xBD3F cosa_1c 0xD684-0xD68F a cero y, con 0xCB21 entre 0x14 y 0x16, 0xCB21 = 0x11
L 0xBD4C cosa_1d 0xD690-0xD69B a cero y, con 0xCB21 entre 0x17 y 0x19, 0xCB21 = 0x12
L 0xBD59 cosa_1e 0xD69C-0xD6A7 a cero y, con 0xCB21 entre 0x1A y 0x1C, 0xCB21 = 0x13
L 0xBD66 borra_12 12 bytes de HL a cero
L 0xBD6C cambia_cb21 con 0xCB21 entre B y C - 1: 0xCB21 = E y p10:BA03
L 0xBD7A fondo_de_la_cosa p03:BF55 y el sitio de la cosa a la otra pagina o a 0
L 0xBD82 lleva_cosa desde la 0x32, solo el rotulo y 0xCAC7 = 1
L 0xBD86 lleva_cosa_si la tiene (p03:BDAD), le suma lo de p56:A67E (p03:BDB3), lo que dice (p03:BE0B) y el rotulo
L 0xBDA5 suma_7 suma 7 a la cosa 1 (B = 1, C = 7)
L 0xBDAD la_tiene el byte 0 de su ficha de 0xD600 a 1
L 0xBDB3 cuantas_trae B = lo que trae (p56:A67E); 0xFF: p03:BDF5
L 0xBDBC suma_a_la_cosa la cuenta (BCD) de la ficha C + B...
L 0xBDF5 suma_a_las_dos 50 a la cosa 0 y 60 a la 1
L 0xBE03 ficha_de_cosa HL = 0xD600 + A * 4: la ficha de lo que lleva Snake
L 0xBE0B dice_lo_que_lleva la cuenta del arma y la del equipo en el marcador
L 0xBE10 dice_el_arma la cuenta de 0xCB20 (0xD704 fuera del paso 0) en 0xE088 (p10:B960)
L 0xBE22 dice_el_equipo con 0xCB21 (0xD704 fuera del paso 0) entre 0x20 y 0x22, su cuenta (cosa + 0x0D) en 0xE0B8
L 0xBE42 tiene_balas acarreo si la cuenta de la cosa A de 0xD600 es 0
L 0xBE45 tiene_cuenta los dos bytes de la cuenta a cero: acarreo
L 0xBE51 suma_una la cosa A: la tiene y una mas
L 0xBE60 gasta_una la cosa A una menos; con 1 y 2, nada mas; si se acaba, fuera de las manos y el mensaje de p10:B3E5 con 0xD874
L 0xBE93 ficha_de_a HL = DE + (A - 1) * 4 + 1: la cuenta de la ficha A
L 0xBE9C resta_una la cuenta BCD de 16 bits de HL menos 1
L 0xBEA1 resta_bcd (HL) - 1 en decimal
L 0xBEA7 suma_una_bcd la cuenta BCD de 16 bits de HL mas 1
L 0xBEAC suma_bcd (HL) + 1 en decimal
L 0xBEB2 tiene_cuenta_d638 acarreo si la cuenta de la cosa A de 0xD638 es 0
L 0xBEB7 gasta_una_d638 la cosa A de 0xD638 una menos; a cero, no la tiene
L 0xBECE rotulo_de_la_cosa 0xCAA8 = 1, la ventana del rotulo (guardando el fondo) y el rotulo A
L 0xBEE5 sitio_del_rotulo_cosa HL = (0x30, 0x0C) o (0x30, 0x9C) con Snake arriba; BC = 0x60 x 0x18
L 0xBEF4 guarda_fondo_rotulo el rectangulo a (0x30, 0xE0) de la pagina de dibujar
L 0xBEFF ventana_del_rotulo el fondo al color 9 y el marco en el color 7
L 0xBF14 quita_el_rotulo con 0xCAC7 = 2 una tecla o un disparo recien pulsados lo quitan; si no, tambien con un disparo apretado
L 0xBF55 cosa_que_cuenta acarreo si la cosa es de las de 0xCAC9-0xCACD (zonas 3 y 4, ciertas salas) y aun vale
L 0xBFB0 pausa A = 0xCAC0: con la pausa, la orden 0xF2 y el rotulo de p03:BFD8 en X = 0x4C, Y = 0x58; sin ella, p03:BFE2
L 0xBFE2 sin_pausa la orden 0xF1 y el rectangulo otra vez en su sitio
