L 0x98F0 que_estado B = el estado: 6 con 0xCB20 = 5...
L 0x990E que_estado_b ...1 con 0xCB35, si no 0
L 0x992A pon_cb35 0xCB35 = 1 si 0xCB20 es 1, 2, 5 o 6
L 0x9932 cb35_segun_cb20 B = 0 con 0xCB20 = 1, 2, 5 o 6; si no, 1
L 0x9942 delante_de_snake lo que hay delante de Snake: p11:A117 y p01:6A19 o p01:6ACA; si no, p01:6A15
L 0x995E punto_delante L = la Y, H = la X de Snake mas lo de su direccion en p02:9980
L 0x9976 mira_delante hacia arriba p01:7F3D, si no p01:7F88
L 0x9988 zonas_de_estado_0b con 0xCA8D puesto, solo con 0xCB29 = 0x20 (y lo borra)
L 0x99AA busca_zona_0b solo yendo arriba o abajo
L 0x99E3 ficha_de_estado_0b en las especiales, primero la especial
L 0x9A5B rectangulo_de_be92 los rectangulos de p30:BE92 [zona][sala][Y][Y][X][X] hasta 0xFF: acarreo si Snake esta en uno
L 0x9A96 llama_a14d_a2aa_a139 p06:A14D, p06:A2AA y p06:A139 con el banco 6
L 0x9AA5 el_agua solo en la zona 6: 0xCAAA, 0xCB3F y la barra de la derecha
L 0x9AB4 cambia_caaa con 0xCAAA puesto, cualquier disparo recien pulsado lo quita
L 0x9AD3 cb3f_y_barra el 0xCB3F de antes...
L 0x9AF3 que_cb3f 0xCB3F = 0
L 0x9B31 barra_si_cambia B = el 0xCB3F de antes
L 0x9B60 gasta_la_barra con 0xCB3F >= 2, cada 16 cuadros (0xCA98)...
L 0x9B80 baja_la_vida la vida baja dos puntos...
L 0x9BA4 empuje p06:A387
L 0x9BDB a_p06_a387 p06:A387 con el banco 6 en 0xA000
L 0x9BE4 rastro_de_snake con 0xCAA0, guarda la Y, la X y la direccion de Snake en 0xE080 (el rastro)
L 0x9C02 pisa_algo en la especial 0x38 sala 1 (p06:BD9B), la zona 0x12 (p06:BD7D) o la 0x13 (p06:BD8E): lo que pisan Snake o 0xCB80
L 0x9C5E cb80_a_cero 0xCB80 = 0 y p01:6C6B
L 0x9C65 pisa_con_cb21_20 p01:6ACE
L 0x9C7C mira_d6b4 con 0xD6B4 puesto...
L 0x9C9C apunta_lo_pisado el nibble bajo de B...
L 0x9CB8 bits_de_lo_pisado A = 0: el bit 0 de 0xD7DE; 1: el 0 de 0xD7E4; 2: el 1 de 0xD7E4
L 0x9CCD bits_de_lo_pisado_0 el bit 7 de 0xD7F1 a cero y el 5 de 0xD7D8 a uno
L 0x9CDA mosaico_de_lo_pisado el nibble alto de B: el mosaico de p06:BD1B...
L 0x9CF4 lista_de_pisar fichas de 4 bytes [sala][tipo][Y][X] hasta 0xFF
L 0x9D36 lo_pisan el nibble alto del tipo (menos 3 si pasa de 2)...
L 0x9D9A suma_tamano E + (HL), D + (HL + 1)
L 0x9DA8 a_p06_a330 p06:A330 con el banco 6 en 0xA000
L 0x9DB1 llama_6e0d_a3c8 p01:6E0D y p06:A3C8
L 0x9DBD que_hay_conectado 0xC38B: bit 0 = hay disquetera (0xFFA7 no es un ret), bit 1 = hay Game Master 2
L 0x9DD4 busca_gm2 busca en los 4 slots (y sus subslots) un cartucho con "YZ" en 0x4010: el Game Master 2; 0xC38A = su slot o 0xFF
L 0x9DF7 busca_gm2_subslots el bit 7 de expandido con el slot...
L 0x9E07 es_gm2 el slot que se mira
L 0x9E2B partida_nueva la partida desde el principio
L 0x9E94 empieza_la_partida sin 0xCA97, las rachas de p37
L 0x9EE5 segun_d66c con 0xD66C: 0xCA7B-0xCA7D = 1, 0x80, 0; o, con el bit 5 de 0xD7D7, 0xCA7B = 3 y p10:A234
L 0x9F02 segun_d670 con 0xD670: 0xCA90 = 1 (4 con el bit 3 de 0xD7D7) y 0xCA91-0xCA92 = 0x0100
L 0x9F23 segun_d674 con 0xD674: 0xCA89 = 2 y 0xCA8C = 0x10; con el bit 3 de 0xD7D4, 0xCA89 = 0 y 0xCA8A = 0x4000; con el 2, 4 y 0x0200
L 0x9F50 segun_d7d5 con el bit 3 (y sin el 2) de 0xD7D5: 0xCB39 = 1 y 0xCB3A = 0x0080
L 0x9F65 segun_d7de los bits de 0xD7FE: el 7 con el 0 de 0xD7DE, el 5 con el 0 de 0xD7E4, el 6 con el 1 de 0xD7E4
L 0x9F7D cambia_d4f5 si no sale de la sala, 0xD4F5 = 0xCB3F (2 como mucho) y, si cambia, p01:6CCA
L 0x9F94 cuenta_cb3a con 0xCB39, sin 0xCA5F, chocando y sin 0xCB3C
L 0x9FE6 pon_cb3d salvo en el estado 0x14: 0xCB3D = 1 y 0xCB3E = 16 (si no estaba)
L 0x9FF7 cuenta_cb3d con 0xCB3D, 0xCB3E un cuadro menos
